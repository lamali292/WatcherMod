<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project="build/mod.build.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <AssemblyName>Watcher</AssemblyName>
        <!--NoWarn>$(NoWarn);STS002</NoWarn-->
    </PropertyGroup>

    <ItemGroup>
        <!-- Localization/asset files for every submod, so the pck picker below can find them -->
        <AdditionalFiles Include="Watcher/localization/**/*.json"/>


        <EmbeddedResource Remove="Watcher/**;"/>
        <None Include="Watcher/**"/>
        <Compile Remove="Watcher/**"/>
        <None Include="WatcherCode/**"/>
        <None Include="Watcher.json"/>
        <None Include="local.props"/>
        <None Include="local.props.example"/>
        <None Include=".gitignore"/>
        <Compile Include="WatcherCode/**/*.cs"/>
    </ItemGroup>

    <PropertyGroup>
        <ModOutputFolder>Watcher</ModOutputFolder>
        <PackFolders>Watcher</PackFolders>
    </PropertyGroup>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="Watcher.json" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModsPath)$(ModOutputFolder)/"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>

        <Message Text="Copying BaseLib dependencies..." Importance="high"/>
        <ItemGroup Condition="'$(UseLocalBaseLib)' != 'true'">
            <BaseLibFiles Include="$(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/lib/**/BaseLib.dll;$(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.pck;$(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.json;"/>
        </ItemGroup>
        <Copy SourceFiles="@(BaseLibFiles)" DestinationFolder="$(ModsPath)BaseLib/"/>

        <!-- Also drop the build into the OTHER configured branch's mods folder (dll compiled against THIS
             branch's sts2.dll; build with -p:Sts2Branch=<other> to replace it with a native one). -->
        <ItemGroup>
            <_MirrorFile Include="$(TargetPath);Watcher.json"/>
            <_MirrorFile Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
            <_MirrorDir Include="$(Sts2BetaPath)/mods/$(ModOutputFolder)/"
                        Condition="'$(Sts2BetaPath)' != '' and '$(Sts2BetaPath)' != '$(Sts2Path)' and Exists('$(Sts2BetaPath)/mods')"/>
            <_MirrorDir Include="$(Sts2PublicPath)/mods/$(ModOutputFolder)/"
                        Condition="'$(Sts2PublicPath)' != '' and '$(Sts2PublicPath)' != '$(Sts2Path)' and Exists('$(Sts2PublicPath)/mods')"/>
            <_MirrorBaseLibDir Include="$(Sts2BetaPath)/mods/BaseLib/"
                               Condition="'$(Sts2BetaPath)' != '' and '$(Sts2BetaPath)' != '$(Sts2Path)' and Exists('$(Sts2BetaPath)/mods')"/>
            <_MirrorBaseLibDir Include="$(Sts2PublicPath)/mods/BaseLib/"
                               Condition="'$(Sts2PublicPath)' != '' and '$(Sts2PublicPath)' != '$(Sts2Path)' and Exists('$(Sts2PublicPath)/mods')"/>
        </ItemGroup>
        <Copy SourceFiles="@(_MirrorFile)" DestinationFolder="%(_MirrorDir.Identity)" Condition="'@(_MirrorDir)' != ''"/>
        <Copy SourceFiles="@(BaseLibFiles)" DestinationFolder="%(_MirrorBaseLibDir.Identity)" Condition="'@(_MirrorBaseLibDir)' != ''"/>
    </Target>

    <Target Name="GodotImport" BeforeTargets="GodotPublish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(SkipGodotImport)' != 'true'">
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; --import --quit --extra-args --no-window"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="true"
              IgnoreStandardErrorWarningFormat="true"/>
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="--- PACKING COMBINED RELEASE: '$(PackFolders)' ---" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; -s build/pack_mod.gd -- &quot;$(ModsPath)$(ModOutputFolder)/Watcher.pck&quot; $(PackFolders.Replace(';', ' '))"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="false"
              IgnoreStandardErrorWarningFormat="true"/>

        <!-- Mirror the freshly packed pck into the other configured branch's mods folder too. -->
        <ItemGroup>
            <_PckMirrorDir Include="$(Sts2BetaPath)/mods/$(ModOutputFolder)/"
                           Condition="'$(Sts2BetaPath)' != '' and '$(Sts2BetaPath)' != '$(Sts2Path)' and Exists('$(Sts2BetaPath)/mods')"/>
            <_PckMirrorDir Include="$(Sts2PublicPath)/mods/$(ModOutputFolder)/"
                           Condition="'$(Sts2PublicPath)' != '' and '$(Sts2PublicPath)' != '$(Sts2Path)' and Exists('$(Sts2PublicPath)/mods')"/>
        </ItemGroup>
        <Copy SourceFiles="$(ModsPath)$(ModOutputFolder)/Watcher.pck" DestinationFolder="%(_PckMirrorDir.Identity)"
              Condition="'@(_PckMirrorDir)' != ''"/>
    </Target>


    <PropertyGroup>
        <DefineConstants>$(DefineConstants);V107</DefineConstants>
    </PropertyGroup>
</Project>